  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "packages": {},
        "requests": {},
        "exec": [
          "if(pm.info.requestName==\"UpdateABooking\"|| pm.info.requestName==\"DeleteABooking\"){",
          "    pm.sendRequest(",
          "    {",
          "        url: pm.environment.get(\"baseURL\") + \"/auth\",",
          "        method: \"POST\",",
          "        header: {",
          "            \"Content-Type\": \"application/json\"",
          "        },",
          "        body: {",
          "                mode: \"raw\",",
          "                raw: JSON.stringify({",
          "                username: \"admin\",",
          "                password: \"password123\"",
          "            })",
          "        }",
          "    },",
          "    function (err, response) {",
          "        if (err) {",
          "            console.log(err);",
          "        } else {",
          "            const token = response.json().token;",
          "",
          "            console.log(\"Generated token: \" + token);",
          "",
          "            pm.environment.set(\"ScriptToken\", token);",
          "        }",
          "    }",
          ");",
          "}"
        ]
      }
